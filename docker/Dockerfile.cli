# =============================================================================
# =============================================================================

FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS builder

ARG CARGO_BUILD_JOBS=1

ARG RUST_TOOLCHAIN=1.99.1
# Must equal the binding set compiled into xberg-pdfium-render
# (`src/lib.rs` includes `bindgen/pdfium_7678.rs`, the only one in the tree). The engine
# dlopen()s this library at run time, so a mismatch is not a build error: a missing symbol
# surfaces as MissingDependency via the 446-symbol probe, but a symbol whose signature or
# struct layout changed is undetected (build.rs sets layout_tests(false)). ~keep
ARG PDFIUM_VERSION=7678

WORKDIR /build

# Alpine's /bin/sh is busybox ash, which supports `-o pipefail`. Without it the
# `curl ... | sh` rustup bootstrap below reports only sh's status, so a failed or
# truncated download silently installs nothing. (hadolint DL4006)
SHELL ["/bin/ash", "-o", "pipefail", "-c"]

RUN apk add --no-cache \
    curl musl-dev cmake make pkgconf \
    perl linux-headers git file && \
    apk add --no-cache \
        gcc g++ libstdc++ libstdc++-dev \
        onnxruntime-dev libheif-dev libde265-dev aom-dev x265-dev dav1d-dev \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain "${RUST_TOOLCHAIN}" --component rust-src
ENV PATH="/root/.cargo/bin:${PATH}"

ENV RUSTFLAGS="-C target-feature=-crt-static"

ENV ORT_LIB_LOCATION=/usr/lib
ENV ORT_PREFER_DYNAMIC_LINK=1

# Download pdfium (musl build). bblanchon/pdfium-binaries is the only source for a
# musl-linked libpdfium.so -- chromium-browser-snapshots (the mirror used below for
# the glibc images) does not publish musl artifacts, so this is single-source with
# retries rather than a fallback mirror. The library is loaded at RUNTIME via
# PDFIUM_DYNAMIC_LIB_PATH (crates/xberg/src/extractors/pdf/pdfium_engine.rs), not
# linked at build time, so nothing else here needs to reference it.
RUN mkdir -p /build/pdfium && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then PDFIUM_ARCH="arm64"; else PDFIUM_ARCH="x64"; fi && \
    curl -fL --retry 5 --retry-delay 2 --retry-max-time 180 --retry-all-errors \
        "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/${PDFIUM_VERSION}/pdfium-linux-musl-${PDFIUM_ARCH}.tgz" \
        -o /build/pdfium.tgz && \
    tar -xzf /build/pdfium.tgz -C /build/pdfium && \
    rm /build/pdfium.tgz && \
    strip --strip-unneeded /build/pdfium/lib/libpdfium.so

COPY Cargo.toml Cargo.lock ./
COPY vendored/sysinfo/ vendored/sysinfo/
COPY crates/xberg/ crates/xberg/
COPY crates/xberg-gliner/ crates/xberg-gliner/
COPY crates/xberg-cli/ crates/xberg-cli/
COPY crates/xberg-libheif/ crates/xberg-libheif/
COPY crates/xberg-libwpd/ crates/xberg-libwpd/
COPY crates/xberg-tesseract/ crates/xberg-tesseract/
COPY crates/xberg-paddle-ocr/ crates/xberg-paddle-ocr/
COPY crates/xberg-candle-ocr/ crates/xberg-candle-ocr/
COPY crates/xberg-pdfium-render/ crates/xberg-pdfium-render/
COPY crates/xberg-native-pdf/ crates/xberg-native-pdf/

RUN sed -i '/xberg-py/d; /xberg_rb/d; /xberg-node/d; /xberg-ffi/d; /xberg-jni/d; /xberg-php/d; /xberg-rag/d; /xberg_rustler/d; /xberg_nif/d; /packages\/dart\/rust/d; /packages\/swift\/rust/d; /\"crates\/xberg-wasm\"/d; /^\[profile\.release\.package\.xberg-wasm\]$/,/^$/d; /benchmark-harness/d; /e2e-generator/d; /e2e\/rust/d' Cargo.toml

# See #1845: `.dockerignore` excludes `**/.git/`, so build.rs's git derivation fails even though
# `git` is installed above, and XBERG_BUILD_ID falls back to `""` -- collapsing the OCR cache key
# space across every image at the same crate version. Unset is a hard failure; an empty value
# would fall back through build.rs's `!id.is_empty()` check and silently restore it. ~keep
ARG XBERG_BUILD_ID

RUN : "${XBERG_BUILD_ID:?must be passed: --build-arg XBERG_BUILD_ID=<commit sha>; see crates/xberg/build.rs}" && \
    cargo build --profile release-musl --package xberg-cli --features all && \
    cp target/release-musl/xberg /build/xberg && \
    strip /build/xberg

RUN file /build/xberg && \
    echo "=== Dynamic dependencies ===" && \
    readelf -d /build/xberg 2>/dev/null | grep NEEDED || echo "No external dependencies"

FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

# Alpine's `onnxruntime` ships a 16.7 MB `onnx_test_runner` test harness, and pulls
# `protoc` in transitively for its codegen executables. None of them are reachable at
# runtime -- the CLI links `libonnxruntime.so` and `libprotoc.so`, not these binaries --
# so they are deleted in the same layer as the install (a later `rm` would leave the
# bytes in the lower layer and shrink nothing). Worth ~23 MB on amd64, measured. Do NOT
# extend this to the libheif codecs: `libheif-x265`/`libheif-aom` back HEIC *encoding*,
# which is a supported image output format (core/image_encode.rs). ~keep
RUN apk add --no-cache libgcc && \
    apk add --no-cache \
        libstdc++ \
        onnxruntime \
        libheif libheif-libde265 libheif-aom libheif-dav1d libheif-x265 \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main && \
    rm -f /usr/bin/onnx_test_runner /usr/bin/protoc /usr/bin/protoc-[0-9]* \
          /usr/bin/protoc-gen-upb-* /usr/bin/protoc-gen-upbdefs-*

COPY --from=builder /build/xberg /usr/local/bin/xberg
COPY LICENSE THIRD_PARTY_LICENSES.md /usr/local/share/licenses/xberg/
COPY --from=builder /build/pdfium/lib/libpdfium.so /usr/local/lib/

LABEL org.opencontainers.image.source="https://github.com/xberg-io/xberg"
LABEL org.opencontainers.image.description="Xberg document intelligence - CLI variant"
LABEL org.opencontainers.image.licenses="MIT"

ARG XBERG_BUILD_ID

# Read at runtime by extract_core_pdfium's bind_once() -- see
# crates/xberg/src/extractors/pdf/pdfium_engine.rs. Set explicitly rather than
# relying on musl's default dlopen search path, which is not guaranteed to
# include /usr/local/lib.
ENV PDFIUM_DYNAMIC_LIB_PATH=/usr/local/lib

# Inspection only: `cache_version_tag` reads this through `env!`, so it is baked in at compile
# time and a runtime value changes nothing. Present so `docker inspect` can report which build id
# the binary carries. ~keep
ENV XBERG_BUILD_ID=${XBERG_BUILD_ID}

ENTRYPOINT ["xberg"]

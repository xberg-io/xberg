# =============================================================================
# =============================================================================
FROM rust:1.100.0-trixie@sha256:e19840879045c951c905d0eaa9887f3439c62000e429963371b376bac8d38c31 AS builder

ARG CARGO_BUILD_JOBS=1

ARG CMAKE_BUILD_PARALLEL_LEVEL=1

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        cmake \
        g++ \
        pkg-config \
        libssl-dev \
        libleptonica-dev \
        libtesseract-dev \
        tesseract-ocr-eng \
        python3 \
        libpng-dev libjpeg-dev libtiff-dev zlib1g-dev \
        libgif-dev libwebp-dev libopenjp2-7-dev \
        libarchive-dev libcurl4-openssl-dev \
        libdav1d-dev \
        clang \
        nasm \
        curl \
        file \
        ca-certificates \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/ci/install-system-deps/build-ocr-linux.sh scripts/ci/install-system-deps/verify-ocr-linux.py scripts/ci/install-system-deps/verify-ocr-fixture.sh /opt/xberg-ocr/
RUN OCR_BUILD_JOBS="${CMAKE_BUILD_PARALLEL_LEVEL:-1}" bash /opt/xberg-ocr/build-ocr-linux.sh

RUN cd /tmp && \
    curl -fsSL -o libde265.tar.gz https://github.com/strukturag/libde265/releases/download/v1.1.3/libde265-1.1.3.tar.gz && \
    echo "554228bd17788c99a7e63b37ab5634722190e6e2bf60c1dcb01cef328e133905  libde265.tar.gz" | sha256sum -c - && \
    tar -xzf libde265.tar.gz && \
    cd libde265-1.1.3 && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=ON -DENABLE_SDL=OFF && \
    cmake --build build -j"${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}" && \
    cmake --install build && \
    ldconfig && \
    cd / && rm -rf /tmp/libde265*

RUN cd /tmp && \
    curl -fsSL -o libaom.tar.gz https://storage.googleapis.com/aom-releases/libaom-3.15.2.tar.gz && \
    echo "67bb54b245f33ed98600e08269e6139986e48114e14042474ddd8885801dfddc  libaom.tar.gz" | sha256sum -c - && \
    tar -xzf libaom.tar.gz && \
    cd libaom-3.15.2 && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=ON \
        -DENABLE_APPS=OFF -DENABLE_EXAMPLES=OFF -DENABLE_TESTS=OFF -DENABLE_DOCS=OFF -DENABLE_TOOLS=OFF && \
    cmake --build build -j"${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}" && \
    cmake --install build && \
    ldconfig && \
    cd / && rm -rf /tmp/libaom*

# Decode-only: these images do not support HEIF output, so keep the GPL-2.0 x265
# encoder (libheif's default when x265 headers exist), x264 and the unused AV1 encoder
# out. ImageOutputFormat::Heif then reports EncoderUnavailable. ~keep
RUN cd /tmp && \
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig && \
    curl -fsSL -o libheif.tar.gz https://github.com/strukturag/libheif/releases/download/v1.23.7/libheif-1.23.7.tar.gz && \
    echo "f7483e818503ea6224c8863e4a56ac02c7089021a98472c811c12aa19faf2475  libheif.tar.gz" | sha256sum -c - && \
    tar -xzf libheif.tar.gz && \
    cd libheif-1.23.7 && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_INSTALL_LIBDIR=lib \
        -DWITH_EXAMPLES=OFF -DWITH_GDK_PIXBUF=OFF -DWITH_X265=OFF -DWITH_X264=OFF -DWITH_AOM_ENCODER=OFF -DBUILD_TESTING=OFF && \
    cmake --build build -j"${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}" && \
    cmake --install build && \
    ldconfig && \
    test "$(pkg-config --modversion libheif)" = 1.23.7 && \
    test "$(pkg-config --modversion libde265)" = 1.1.3 && \
    test "$(pkg-config --modversion aom)" = 3.15.2 && \
    cd / && rm -rf /tmp/libheif*

# Must equal the binding set compiled into xberg-pdfium-render
# (`src/lib.rs` includes `bindgen/pdfium_7678.rs`, the only one in the tree). The engine
# dlopen()s this library at run time, so a mismatch is not a build error: a missing symbol
# surfaces as MissingDependency via the 446-symbol probe, but a symbol whose signature or
# struct layout changed is undetected (build.rs sets layout_tests(false)). ~keep
ARG PDFIUM_VERSION=7678
ARG ONNXRUNTIME_VERSION=1.24.2
ARG TARGETARCH
ENV PDFIUM_VERSION=${PDFIUM_VERSION}
ENV ONNXRUNTIME_VERSION=${ONNXRUNTIME_VERSION}

# The manifests bind each version override to a trusted digest for the target architecture. ~keep
COPY scripts/ci/actions/setup-onnx-runtime/verify-archive.sh scripts/pdfium-runtime-checksums.sha256 /opt/xberg-integrity/
COPY scripts/ci/actions/setup-onnx-runtime/nuget-fallback.sh /opt/xberg-integrity/nuget-fallback.sh
COPY scripts/ci/actions/setup-onnx-runtime/checksums.sha256 /opt/xberg-integrity/onnxruntime-checksums.sha256

RUN mkdir -p /build/pdfium && \
    case "$PDFIUM_VERSION" in ''|*[!0-9]*) echo "Invalid PDFium Chromium revision: $PDFIUM_VERSION" >&2; exit 1 ;; esac && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        PDFIUM_ARCH="arm64"; \
    else \
        PDFIUM_ARCH="x64"; \
    fi && \
    PDFIUM_ASSET="pdfium-linux-${PDFIUM_ARCH}.tgz" && \
    PDFIUM_ARCHIVE="/build/${PDFIUM_VERSION}-${PDFIUM_ASSET}" && \
    bash /opt/xberg-integrity/verify-archive.sh "$PDFIUM_ARCHIVE" /opt/xberg-integrity/pdfium-runtime-checksums.sha256 --known && \
    curl -fL --retry 5 --retry-delay 2 --retry-max-time 180 --retry-all-errors \
        "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/${PDFIUM_VERSION}/${PDFIUM_ASSET}" \
        -o "$PDFIUM_ARCHIVE" && \
    bash /opt/xberg-integrity/verify-archive.sh "$PDFIUM_ARCHIVE" /opt/xberg-integrity/pdfium-runtime-checksums.sha256 && \
    tar -xzf "$PDFIUM_ARCHIVE" -C /build/pdfium && \
    rm "$PDFIUM_ARCHIVE"

RUN mkdir -p /build/onnxruntime && \
    case "$ONNXRUNTIME_VERSION" in ''|*[!A-Za-z0-9._-]*) echo "Invalid ONNX Runtime version: $ONNXRUNTIME_VERSION" >&2; exit 1 ;; esac && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        ORT_ARCH="aarch64"; \
        ORT_RID="linux-arm64"; \
    else \
        ORT_ARCH="x64"; \
        ORT_RID="linux-x64"; \
    fi && \
    ORT_ASSET="onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}.tgz" && \
    ORT_ARCHIVE="/build/$ORT_ASSET" && \
    bash /opt/xberg-integrity/verify-archive.sh "$ORT_ARCHIVE" /opt/xberg-integrity/onnxruntime-checksums.sha256 --known && \
    if curl -fL "https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/${ORT_ASSET}" \
        -o "$ORT_ARCHIVE"; then \
        bash /opt/xberg-integrity/verify-archive.sh "$ORT_ARCHIVE" /opt/xberg-integrity/onnxruntime-checksums.sha256 && \
        tar -xzf "$ORT_ARCHIVE" -C /build/onnxruntime --strip-components=1; \
    else \
        rm -f "$ORT_ARCHIVE" && \
        RUNNER_TEMP=/tmp bash /opt/xberg-integrity/nuget-fallback.sh "$ONNXRUNTIME_VERSION" "$ORT_RID" /build/onnxruntime /opt/xberg-integrity/onnxruntime-checksums.sha256; \
    fi && \
    rm -f "$ORT_ARCHIVE"

COPY Cargo.toml Cargo.lock ./
COPY vendored/sysinfo/ vendored/sysinfo/
COPY crates/xberg/ crates/xberg/
COPY crates/xberg-gliner/ crates/xberg-gliner/
COPY crates/xberg-cli/ crates/xberg-cli/
COPY crates/xberg-libheif/ crates/xberg-libheif/
COPY crates/xberg-libwpd/ crates/xberg-libwpd/
COPY crates/xberg-tesseract/ crates/xberg-tesseract/
COPY crates/xberg-paddle-ocr/ crates/xberg-paddle-ocr/
COPY crates/xberg-candle-ocr/ crates/xberg-candle-ocr/
COPY crates/xberg-pdfium-render/ crates/xberg-pdfium-render/
COPY crates/xberg-native-pdf/ crates/xberg-native-pdf/

RUN sed -i '/xberg-py/d; /xberg_rb/d; /xberg-node/d; /xberg-ffi/d; /xberg-jni/d; /xberg-php/d; /xberg-rag/d; /xberg_rustler/d; /xberg_nif/d; /packages\/dart\/rust/d; /packages\/swift\/rust/d; /"crates\/xberg-wasm"/d; /^\[profile\.release\.package\.xberg-wasm\]$/,$d; /benchmark-harness/d; /e2e-generator/d; /e2e\/rust/d' Cargo.toml

# `.dockerignore` excludes `**/.git/`, so build.rs cannot derive XBERG_BUILD_ID from git here and
# falls back to `""` -- which makes every image at the same crate version share one cache key
# space (#1845). Declared here rather than at the top of the stage because a changed ARG
# invalidates every layer below it, and the layers above are apt + a from-source libheif + the
# pdfium/ORT downloads. Unset is a hard failure: an empty value falls straight back through
# build.rs's `!id.is_empty()` check and silently restores the collision. ~keep
ARG XBERG_BUILD_ID
# The publish workflow passes thin for arm64, where fat LTO exhausts the runner's memory.
ARG CARGO_PROFILE_RELEASE_LTO=fat

# `ort-dynamic`: xberg does not link ONNX Runtime; it loads the digest-verified
# /usr/local/lib/libonnxruntime.so staged below (`<prefix>/lib` for /usr/local/bin/xberg) on first
# model use. ~keep
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    : "${XBERG_BUILD_ID:?must be passed: --build-arg XBERG_BUILD_ID=<commit sha>; see crates/xberg/build.rs}" && \
    export CARGO_PROFILE_RELEASE_LTO="${CARGO_PROFILE_RELEASE_LTO:?}" && \
    cargo build --release --package xberg-cli --features all,ort-dynamic && \
    cp target/release/xberg /build/xberg && \
    strip /build/xberg

# tessdata_best for the `best` target, at the revision and digests pinned in
# crates/xberg/src/ocr/tessdata_download/pins.rs (scripts/ci/tessdata/generate_best_manifest.py).
# The zero mtimes keep the copied layer identical across builds. ~keep
FROM debian:trixie-20261027-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4 AS tessdata-best

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/ci/tessdata/tessdata_best.revision scripts/ci/tessdata/tessdata_best.sha256 /opt/tessdata-best/
WORKDIR /tessdata-best
RUN set -eu; \
    revision="$(cat /opt/tessdata-best/tessdata_best.revision)"; \
    case "$revision" in *[!0-9a-f]*|'') echo "Invalid tessdata_best revision: $revision" >&2; exit 1 ;; esac; \
    [ "${#revision}" -eq 40 ]; \
    while read -r _ name; do \
        curl -fsSL --retry 5 --retry-delay 2 --retry-max-time 300 --retry-all-errors -o "$name" \
            "https://raw.githubusercontent.com/tesseract-ocr/tessdata_best/${revision}/${name}"; \
    done </opt/tessdata-best/tessdata_best.sha256; \
    sha256sum --strict -c /opt/tessdata-best/tessdata_best.sha256; \
    mkdir models license; \
    mv ./*.traineddata models/; \
    mv LICENSE license/; \
    find models license -type f -exec touch -d @0 {} +

FROM debian:trixie-20261027-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4 AS runtime

LABEL org.opencontainers.image.source="https://github.com/xberg-io/xberg"
LABEL org.opencontainers.image.description="Xberg document intelligence - core variant"
# The image bundles libheif/libde265 (LGPL-3.0-or-later), libaom/libdav1d and
# PDFium (BSD-2/3-Clause) and statically linked libwpd/librevenge (MPL-2.0); the
# core/full images also carry the statically built Tesseract (Apache-2.0). No image
# ships GPL code: x265 is compiled out everywhere (#3340). ~keep
LABEL org.opencontainers.image.licenses="MIT AND LGPL-3.0-or-later AND BSD-2-Clause AND BSD-3-Clause AND MPL-2.0 AND Apache-2.0"

WORKDIR /app

ARG TARGETARCH

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tini \
        python3 libpng16-16t64 libjpeg62-turbo libtiff6 zlib1g \
        libgif7 libwebp7 libwebpmux3 libopenjp2-7 \
        libarchive13t64 libcurl4t64 libgomp1 \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-osd \
        tesseract-ocr-spa \
        tesseract-ocr-fra \
        tesseract-ocr-deu \
        tesseract-ocr-ita \
        tesseract-ocr-por \
        tesseract-ocr-chi-sim \
        tesseract-ocr-chi-tra \
        tesseract-ocr-jpn \
        tesseract-ocr-ara \
        tesseract-ocr-rus \
        tesseract-ocr-hin \
        libdav1d7 \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY --from=builder /usr/local/lib/libtesseract.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libleptonica.so* /usr/local/lib/
COPY --from=builder /usr/local/bin/tesseract /usr/local/bin/tesseract
COPY --from=builder /usr/local/share/licenses/xberg-system-ocr /usr/local/share/licenses/xberg-system-ocr
COPY scripts/ci/install-system-deps/verify-ocr-linux.py scripts/ci/install-system-deps/verify-ocr-fixture.sh /opt/xberg-ocr/
COPY scripts/ci/verify_no_gpl_codecs.py /opt/xberg-release/verify_no_gpl_codecs.py
COPY --from=builder /usr/local/lib/libheif* /usr/local/lib/
COPY --from=builder /usr/local/lib/libde265.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libaom.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/pkgconfig/libheif.pc /usr/local/lib/pkgconfig/libheif.pc
# ldconfig keeps the first directory that holds a soname. aarch64-linux-gnu.conf sorts before
# libc.conf (/usr/local/lib), so without a 00- entry the distro Leptonica from the tesseract-ocr
# package wins on arm64 and Tesseract loads it instead of the built one.
RUN echo /usr/local/lib >/etc/ld.so.conf.d/00-xberg-ocr.conf && ldconfig && \
    test -f /usr/local/lib/libheif.so.1 && \
    python3 /opt/xberg-release/verify_no_gpl_codecs.py --min-artifacts 1 /usr/local/lib && \
    python3 /opt/xberg-ocr/verify-ocr-linux.py /usr/local && \
    tesseract --version >/tmp/ocr-version 2>&1 && grep -q '^tesseract 5\.5\.4$' /tmp/ocr-version && \
    tesseract --list-langs >/tmp/ocr-languages && grep -qx eng /tmp/ocr-languages && \
    tessdata="$(find /usr/share/tesseract-ocr -type f -name eng.traineddata -print -quit)" && \
    test -n "$tessdata" && \
    bash /opt/xberg-ocr/verify-ocr-fixture.sh /usr/local/bin/tesseract "$(dirname "$tessdata")"

COPY --from=builder /build/onnxruntime/lib/libonnxruntime.so* /usr/local/lib/
COPY --from=builder /build/pdfium/lib/libpdfium.so /usr/local/lib/
RUN ldconfig

COPY --from=builder /build/xberg /usr/local/bin/xberg
COPY LICENSE THIRD_PARTY_LICENSES.md /usr/local/share/licenses/xberg/

RUN groupadd -r xberg && \
    useradd -r -g xberg -d /app -s /sbin/nologin xberg && \
    mkdir -p /app/.xberg && \
    chown -R xberg:xberg /app

RUN mkdir -p /etc/xberg /app/.config/xberg && \
    chown -R xberg:xberg /etc/xberg /app/.config/xberg

RUN mkdir -p /app/.xberg/huggingface && \
    chown -R xberg:xberg /app/.xberg/huggingface

RUN mkdir -p /app/.xberg/paddle-ocr && \
    chown -R xberg:xberg /app/.xberg/paddle-ocr

# Debian installs the language data world-readable, so the nonroot user needs no mode change.
# Assert it rather than changing modes recursively: that copies every traineddata file into a new
# layer and ships the whole language set twice. ~keep
RUN set -eu; \
    unreadable="$(find /usr/share/tesseract-ocr \( \( -type f ! -perm -0444 \) -o \( -type d ! -perm -0555 \) \) -print -quit)"; \
    if [ -n "$unreadable" ]; then echo "tessdata is not world-readable: $unreadable" >&2; exit 1; fi; \
    test -n "$(find /usr/share/tesseract-ocr/*/tessdata -maxdepth 1 -name eng.traineddata -print -quit)"

# Inspection only -- `docker inspect` on a shipped image shows which build id went into it. It has
# no runtime effect: `cache_version_tag` reads the value through `env!`, i.e. baked in at
# compile time, so setting this on a running container changes nothing. Mirrors the ARG/ENV
# pattern already used for PDFIUM_VERSION above. ~keep
ARG XBERG_BUILD_ID

# xberg-cli subscriber defaults in logging.rs, so they won't emit DEBUG
ENV XBERG_CACHE_DIR=/app/.xberg \
    HF_HOME=/app/.xberg/huggingface \
    RUST_LOG=info \
    LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/lib \
    PDFIUM_DYNAMIC_LIB_PATH=/usr/local/lib \
    XBERG_BUILD_ID=${XBERG_BUILD_ID}

USER xberg

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/xberg", "--version"]

ENTRYPOINT ["/usr/bin/tini", "--", "xberg"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]

# The same image with tessdata_best for the image's languages in a read-only directory xberg
# searches for best requests only. TESSDATA_PREFIX stays unset: it would take precedence over the
# model set and serve these files to fast requests too. ~keep
FROM runtime AS best

LABEL org.opencontainers.image.description="Xberg document intelligence - core-best variant"

COPY --link --chmod=0444 --from=tessdata-best /tessdata-best/models/*.traineddata /usr/share/xberg/tessdata/best/
COPY --link --chmod=0444 --from=tessdata-best /tessdata-best/license/LICENSE /usr/local/share/licenses/tessdata_best/LICENSE

ENV XBERG_OCR_TESSDATA_MODEL=best

RUN bash /opt/xberg-ocr/verify-ocr-fixture.sh /usr/local/bin/tesseract /usr/share/xberg/tessdata/best

# The default target: the image without tessdata_best. ~keep
FROM runtime AS fast

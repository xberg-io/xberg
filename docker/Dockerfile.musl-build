# =============================================================================
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS builder

ARG CARGO_BUILD_JOBS=1

ARG RUST_TOOLCHAIN=1.99.1
# Must equal the binding set compiled into xberg-pdfium-render
# (`src/lib.rs` includes `bindgen/pdfium_7678.rs`, the only one in the tree). The engine
# dlopen()s this library at run time, so a mismatch is not a build error: a missing symbol
# surfaces as MissingDependency via the 446-symbol probe, but a symbol whose signature or
# struct layout changed is undetected (build.rs sets layout_tests(false)). ~keep
ARG PDFIUM_VERSION=7678

WORKDIR /build

# Alpine's /bin/sh is busybox ash, which supports `-o pipefail`. Without it the
# `curl ... | sh` rustup bootstrap below reports only sh's status, so a failed or
# truncated download silently installs nothing, and the `readelf ... | grep`
# linkage diagnostics report success on an empty pipe. (hadolint DL4006)
SHELL ["/bin/ash", "-o", "pipefail", "-c"]

RUN apk add --no-cache \
    curl musl-dev cmake make pkgconf \
    perl linux-headers git file patchelf && \
    apk add --no-cache \
        gcc g++ libstdc++ libstdc++-dev \
        onnxruntime-dev libheif-dev libde265-dev aom-dev x265-dev dav1d-dev \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain "${RUST_TOOLCHAIN}" --component rust-src && \
    echo "Rust host: $(~/.cargo/bin/rustc -vV | grep host)" && \
    echo "Default target: $(~/.cargo/bin/rustc --print cfg | grep target)"
ENV PATH="/root/.cargo/bin:${PATH}"

ENV RUSTFLAGS="-C target-feature=-crt-static"

ENV ORT_LIB_LOCATION=/usr/lib
ENV ORT_PREFER_DYNAMIC_LINK=1

# Download pdfium (musl build). bblanchon/pdfium-binaries is the only source for a
# musl-linked libpdfium.so -- there is no musl equivalent of the
# chromium-browser-snapshots mirror used for the glibc images -- so this is
# single-source with retries. Bundled into /build/lib below (not linked at build
# time; see crates/xberg/src/extractors/pdf/pdfium_engine.rs for why).
RUN mkdir -p /build/pdfium && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then PDFIUM_ARCH="arm64"; else PDFIUM_ARCH="x64"; fi && \
    curl -fL --retry 5 --retry-delay 2 --retry-max-time 180 --retry-all-errors \
        "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/${PDFIUM_VERSION}/pdfium-linux-musl-${PDFIUM_ARCH}.tgz" \
        -o /build/pdfium.tgz && \
    tar -xzf /build/pdfium.tgz -C /build/pdfium && \
    rm /build/pdfium.tgz

COPY Cargo.toml Cargo.lock ./
COPY vendored/sysinfo/ vendored/sysinfo/
COPY crates/xberg/ crates/xberg/
COPY crates/xberg-gliner/ crates/xberg-gliner/
COPY crates/xberg-cli/ crates/xberg-cli/
COPY crates/xberg-tesseract/ crates/xberg-tesseract/
COPY crates/xberg-paddle-ocr/ crates/xberg-paddle-ocr/
COPY crates/xberg-candle-ocr/ crates/xberg-candle-ocr/
COPY crates/xberg-pdfium-render/ crates/xberg-pdfium-render/
COPY crates/xberg-native-pdf/ crates/xberg-native-pdf/
COPY crates/xberg-libheif/ crates/xberg-libheif/
COPY crates/xberg-libwpd/ crates/xberg-libwpd/

RUN sed -i '/xberg-py/d; /xberg_rb/d; /xberg-node/d; /xberg-ffi/d; /xberg-jni/d; /xberg-php/d; /xberg-rag/d; /xberg_rustler/d; /xberg_nif/d; /packages\/dart\/rust/d; /packages\/swift\/rust/d; /"crates\/xberg-wasm"/d; /^\[profile\.release\.package\.xberg-wasm\]$/,/^$/d; /benchmark-harness/d; /e2e-generator/d; /e2e\/rust/d' Cargo.toml

# `.dockerignore` excludes `**/.git/`, so build.rs cannot derive XBERG_BUILD_ID from git here and
# falls back to `""` -- which makes every musl xberg-cli binary built at the same crate version share one OCR
# cache key space (#1845). Declared immediately above the build step so a changed value does not
# invalidate the toolchain/dependency layers above. Unset is a hard failure and so is empty:
# build.rs honours the override only when it is non-empty, so an empty value falls straight back
# through its `!id.is_empty()` check and silently restores the collision. ~keep
ARG XBERG_BUILD_ID

RUN : "${XBERG_BUILD_ID:?must be passed: --build-arg XBERG_BUILD_ID=<commit sha>; see crates/xberg/build.rs}" && \
    cargo build --profile release-musl --package xberg-cli --features all && \
    cp target/release-musl/xberg /build/xberg && \
    strip /build/xberg

RUN patchelf --set-rpath '$ORIGIN/lib' /build/xberg

# Transitively copy the shared-library closure into /build/lib until it stops
# growing. The two `|| true` guards in the inner loop are deliberate under this
# stage's `-o pipefail` SHELL: the loader exits non-zero for a library whose deps
# have not been copied in yet (this loop is what copies them), and `grep -E '^/'`
# exits 1 for a library with no absolute-path deps at all. Neither is an error --
# the closure is complete when the file count stops growing, which the `while`
# loop below is what actually decides. ~keep
RUN set -eu; \
    mkdir -p /build/lib/libheif; \
    cp /usr/lib/libstdc++.so.6 /build/lib/; \
    cp /usr/lib/libgcc_s.so.1 /build/lib/; \
    cp /usr/lib/libonnxruntime.so* /build/lib/ 2>/dev/null || true; \
    cp /build/pdfium/lib/libpdfium.so /build/lib/ 2>/dev/null || true; \
    cp /lib/ld-musl-*.so.1 /build/lib/ 2>/dev/null || true; \
    cp -a /usr/lib/libheif/. /build/lib/libheif/; \
    LOADER="$(ls /build/lib/ld-musl-*.so.1 | head -n1)"; \
    while :; do \
        before=$(ls /build/lib | wc -l); \
        for so in /build/xberg /build/lib/*.so* /build/lib/libheif/*.so*; do \
            case "$so" in *ld-musl-*) continue ;; esac; \
            { "$LOADER" --list "$so" 2>/dev/null || true; } \
                | awk '/=>/ { print $3 }' \
                | { grep -E '^/' || true; } \
                | while read -r dep; do \
                    base="$(basename "$dep")"; \
                    if [ ! -e "/build/lib/$base" ]; then \
                        cp -L "$dep" /build/lib/; \
                    fi; \
                done; \
        done; \
        after=$(ls /build/lib | wc -l); \
        [ "$before" = "$after" ] && break; \
    done; \
    for so in /build/xberg /build/lib/*.so* /build/lib/libheif/*.so*; do \
        case "$so" in *ld-musl-*) continue ;; esac; \
        if "$LOADER" --library-path /build/lib --list "$so" 2>&1 | grep -q 'not found'; then \
            echo "FAIL: $so has unresolved dependencies inside the bundle:" >&2; \
            "$LOADER" --library-path /build/lib --list "$so" >&2; \
            exit 1; \
        fi; \
    done; \
    ls /build/lib/libheif.so* >/dev/null; \
    ls /build/lib/libheif/*.so* >/dev/null; \
    echo "OK: every bundled library resolves inside /build/lib/"

RUN mv /build/xberg /build/xberg.bin && \
    INTERP_NAME=$(basename /lib/ld-musl-*.so.1) && \
    printf '#!/bin/sh\nSCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"\nexport LIBHEIF_PLUGIN_PATH="$SCRIPT_DIR/lib/libheif${LIBHEIF_PLUGIN_PATH:+:$LIBHEIF_PLUGIN_PATH}"\nexport PDFIUM_DYNAMIC_LIB_PATH="$SCRIPT_DIR/lib"\nexec "$SCRIPT_DIR/lib/%s" --library-path "$SCRIPT_DIR/lib" "$SCRIPT_DIR/xberg.bin" "$@"\n' \
        "$INTERP_NAME" > /build/xberg && \
    chmod +x /build/xberg

RUN file /build/xberg /build/xberg.bin && \
    echo "=== Dynamic dependencies ===" && \
    readelf -d /build/xberg.bin 2>/dev/null | grep -E "NEEDED|RPATH|RUNPATH" && \
    echo "=== Bundled libraries ===" && \
    find /build/lib -maxdepth 2 -type f -print && \
    /build/xberg --version

FROM scratch
COPY --from=builder /build/xberg /xberg
COPY --from=builder /build/xberg.bin /xberg.bin
COPY --from=builder /build/lib/ /lib/

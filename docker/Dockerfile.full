# =============================================================================
# =============================================================================
FROM rust:1.99.1-trixie@sha256:09027f873d45b8ecd1dc86f1fa13b7a62b875c961f017a0e331267b350430137 AS builder

ARG CARGO_BUILD_JOBS=1

ARG CMAKE_BUILD_PARALLEL_LEVEL=1

WORKDIR /build

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        cmake \
        g++ \
        pkg-config \
        libssl-dev \
        libleptonica-dev \
        libtesseract-dev \
        tesseract-ocr-eng \
        python3 \
        libpng-dev libjpeg-dev libtiff-dev zlib1g-dev \
        libgif-dev libwebp-dev libopenjp2-7-dev \
        libarchive-dev libcurl4-openssl-dev \
        libx265-dev \
        libdav1d-dev \
        clang \
        nasm \
        curl \
        file \
        ca-certificates \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY scripts/ci/install-system-deps/build-ocr-linux.sh scripts/ci/install-system-deps/verify-ocr-linux.py scripts/ci/install-system-deps/verify-ocr-fixture.sh /opt/xberg-ocr/
RUN OCR_BUILD_JOBS="${CMAKE_BUILD_PARALLEL_LEVEL:-1}" bash /opt/xberg-ocr/build-ocr-linux.sh

RUN cd /tmp && \
    curl -fsSL -o libde265.tar.gz https://github.com/strukturag/libde265/releases/download/v1.1.3/libde265-1.1.3.tar.gz && \
    echo "554228bd17788c99a7e63b37ab5634722190e6e2bf60c1dcb01cef328e133905  libde265.tar.gz" | sha256sum -c - && \
    tar -xzf libde265.tar.gz && \
    cd libde265-1.1.3 && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=ON -DENABLE_SDL=OFF && \
    cmake --build build -j"${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}" && \
    cmake --install build && \
    ldconfig && \
    cd / && rm -rf /tmp/libde265*

RUN cd /tmp && \
    curl -fsSL -o libaom.tar.gz https://storage.googleapis.com/aom-releases/libaom-3.15.2.tar.gz && \
    echo "67bb54b245f33ed98600e08269e6139986e48114e14042474ddd8885801dfddc  libaom.tar.gz" | sha256sum -c - && \
    tar -xzf libaom.tar.gz && \
    cd libaom-3.15.2 && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DCMAKE_INSTALL_LIBDIR=lib -DBUILD_SHARED_LIBS=ON \
        -DENABLE_APPS=OFF -DENABLE_EXAMPLES=OFF -DENABLE_TESTS=OFF -DENABLE_DOCS=OFF -DENABLE_TOOLS=OFF && \
    cmake --build build -j"${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}" && \
    cmake --install build && \
    ldconfig && \
    cd / && rm -rf /tmp/libaom*

RUN cd /tmp && \
    export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig && \
    curl -fsSL -o libheif.tar.gz https://github.com/strukturag/libheif/releases/download/v1.23.7/libheif-1.23.7.tar.gz && \
    echo "f7483e818503ea6224c8863e4a56ac02c7089021a98472c811c12aa19faf2475  libheif.tar.gz" | sha256sum -c - && \
    tar -xzf libheif.tar.gz && \
    cd libheif-1.23.7 && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DCMAKE_INSTALL_LIBDIR=lib -DWITH_EXAMPLES=OFF -DWITH_GDK_PIXBUF=OFF -DBUILD_TESTING=OFF && \
    cmake --build build -j"${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc)}" && \
    cmake --install build && \
    ldconfig && \
    test "$(pkg-config --modversion libheif)" = 1.23.7 && \
    test "$(pkg-config --modversion libde265)" = 1.1.3 && \
    test "$(pkg-config --modversion aom)" = 3.15.2 && \
    cd / && rm -rf /tmp/libheif*

# Must equal the binding set compiled into xberg-pdfium-render
# (`src/lib.rs` includes `bindgen/pdfium_7678.rs`, the only one in the tree). The engine
# dlopen()s this library at run time, so a mismatch is not a build error: a missing symbol
# surfaces as MissingDependency via the 446-symbol probe, but a symbol whose signature or
# struct layout changed is undetected (build.rs sets layout_tests(false)). ~keep
ARG PDFIUM_VERSION=7678
ARG ONNXRUNTIME_VERSION=1.24.2
ARG TARGETARCH
ENV PDFIUM_VERSION=${PDFIUM_VERSION}
ENV ONNXRUNTIME_VERSION=${ONNXRUNTIME_VERSION}

# Download and extract pdfium to a location that survives into the runtime stage.
# TARGETARCH is automatically set by Docker: amd64, arm64, etc. The GitHub release
# is tried first, then the chromium-browser-snapshots mirror -- pdfium-binaries
# releases have gone missing/rate-limited before, and this is a published-image
# build, not a best-effort dev one. Both legs get retries; only the combination
# failing should fail the build.
RUN mkdir -p /build/pdfium && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        PDFIUM_ARCH="arm64"; \
    else \
        PDFIUM_ARCH="x64"; \
    fi && \
    (curl -fL --retry 5 --retry-delay 2 --retry-max-time 180 --retry-all-errors \
        "https://github.com/bblanchon/pdfium-binaries/releases/download/chromium/${PDFIUM_VERSION}/pdfium-linux-${PDFIUM_ARCH}.tgz" \
        -o /build/pdfium.tgz \
        || curl -fL --retry 5 --retry-delay 2 --retry-max-time 180 --retry-all-errors \
        "https://storage.googleapis.com/chromium-browser-snapshots/Linux_${PDFIUM_ARCH}/pdfium-${PDFIUM_VERSION}.tgz" \
        -o /build/pdfium.tgz) && \
    tar -xzf /build/pdfium.tgz -C /build/pdfium && \
    rm /build/pdfium.tgz

RUN mkdir -p /build/onnxruntime && \
    if [ "$TARGETARCH" = "arm64" ]; then \
        ORT_ARCH="aarch64"; \
    else \
        ORT_ARCH="x64"; \
    fi && \
    curl -fL "https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/onnxruntime-linux-${ORT_ARCH}-${ONNXRUNTIME_VERSION}.tgz" \
        -o /build/onnxruntime.tgz && \
    tar -xzf /build/onnxruntime.tgz -C /build/onnxruntime --strip-components=1 && \
    rm /build/onnxruntime.tgz

COPY Cargo.toml Cargo.lock ./
COPY vendored/sysinfo/ vendored/sysinfo/
COPY crates/xberg/ crates/xberg/
COPY crates/xberg-gliner/ crates/xberg-gliner/
COPY crates/xberg-cli/ crates/xberg-cli/
COPY crates/xberg-libheif/ crates/xberg-libheif/
COPY crates/xberg-libwpd/ crates/xberg-libwpd/
COPY crates/xberg-tesseract/ crates/xberg-tesseract/
COPY crates/xberg-paddle-ocr/ crates/xberg-paddle-ocr/
COPY crates/xberg-candle-ocr/ crates/xberg-candle-ocr/
COPY crates/xberg-pdfium-render/ crates/xberg-pdfium-render/
COPY crates/xberg-native-pdf/ crates/xberg-native-pdf/

RUN sed -i '/xberg-py/d; /xberg_rb/d; /xberg-node/d; /xberg-ffi/d; /xberg-jni/d; /xberg-php/d; /xberg-rag/d; /xberg_rustler/d; /xberg_nif/d; /packages\/dart\/rust/d; /packages\/swift\/rust/d; /"crates\/xberg-wasm"/d; /^\[profile\.release\.package\.xberg-wasm\]$/,$d; /benchmark-harness/d; /e2e-generator/d; /e2e\/rust/d' Cargo.toml

# `.dockerignore` excludes `**/.git/`, so build.rs cannot derive XBERG_BUILD_ID from git here and
# falls back to `""` -- which makes every image at the same crate version share one cache key
# space (#1845). Declared here rather than at the top of the stage because a changed ARG
# invalidates every layer below it, and the layers above are apt + a from-source libheif + the
# pdfium/ORT downloads. Unset is a hard failure: an empty value falls straight back through
# build.rs's `!id.is_empty()` check and silently restores the collision. ~keep
ARG XBERG_BUILD_ID

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/build/target \
    : "${XBERG_BUILD_ID:?must be passed: --build-arg XBERG_BUILD_ID=<commit sha>; see crates/xberg/build.rs}" && \
    cargo build --release --package xberg-cli --features all && \
    cp target/release/xberg /build/xberg && \
    strip /build/xberg

FROM debian:trixie-20261027-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

LABEL org.opencontainers.image.source="https://github.com/xberg-io/xberg"
LABEL org.opencontainers.image.description="Xberg document intelligence - full variant"
LABEL org.opencontainers.image.licenses="MIT"

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tini \
        python3 libpng16-16t64 libjpeg62-turbo libtiff6 zlib1g \
        libgif7 libwebp7 libwebpmux3 libopenjp2-7 \
        libarchive13t64 libcurl4t64 libgomp1 \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-osd \
        tesseract-ocr-spa \
        tesseract-ocr-fra \
        tesseract-ocr-deu \
        tesseract-ocr-ita \
        tesseract-ocr-por \
        tesseract-ocr-chi-sim \
        tesseract-ocr-chi-tra \
        tesseract-ocr-jpn \
        tesseract-ocr-ara \
        tesseract-ocr-rus \
        tesseract-ocr-hin \
        fontconfig \
        libssl3t64 \
        libx265-215 \
        libdav1d7 \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

COPY --from=builder /usr/local/lib/libtesseract.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libleptonica.so* /usr/local/lib/
COPY --from=builder /usr/local/bin/tesseract /usr/local/bin/tesseract
COPY --from=builder /usr/local/share/licenses/xberg-system-ocr /usr/local/share/licenses/xberg-system-ocr
COPY scripts/ci/install-system-deps/verify-ocr-linux.py scripts/ci/install-system-deps/verify-ocr-fixture.sh /opt/xberg-ocr/
COPY --from=builder /usr/local/lib/libheif* /usr/local/lib/
COPY --from=builder /usr/local/lib/libde265.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/libaom.so* /usr/local/lib/
COPY --from=builder /usr/local/lib/pkgconfig/libheif.pc /usr/local/lib/pkgconfig/libheif.pc
RUN ldconfig && \
    python3 /opt/xberg-ocr/verify-ocr-linux.py /usr/local && \
    tesseract --version >/tmp/ocr-version 2>&1 && grep -q '^tesseract 5\.5\.4$' /tmp/ocr-version && \
    tesseract --list-langs >/tmp/ocr-languages && grep -qx eng /tmp/ocr-languages && \
    tessdata="$(find /usr/share/tesseract-ocr -type f -name eng.traineddata -print -quit)" && \
    test -n "$tessdata" && \
    bash /opt/xberg-ocr/verify-ocr-fixture.sh /usr/local/bin/tesseract "$(dirname "$tessdata")"

COPY --from=builder /build/onnxruntime/lib/libonnxruntime.so* /usr/local/lib/
COPY --from=builder /build/pdfium/lib/libpdfium.so /usr/local/lib/
RUN ldconfig

COPY --from=builder /build/xberg /usr/local/bin/xberg
COPY LICENSE THIRD_PARTY_LICENSES.md /usr/local/share/licenses/xberg/
RUN chmod +x /usr/local/bin/xberg

RUN groupadd -r xberg && \
    useradd -r -g xberg -d /app -s /sbin/nologin xberg && \
    mkdir -p /app/.xberg && \
    chown -R xberg:xberg /app

RUN mkdir -p /etc/xberg /app/.config/xberg && \
    chown -R xberg:xberg /etc/xberg /app/.config/xberg

RUN mkdir -p /app/.xberg/huggingface && \
    chown -R xberg:xberg /app/.xberg/huggingface

# A single Hugging Face 500 failed the 1.3.10 image build and, through the chart gate, skipped
# the Helm chart (#2175); retry the warm so a transient hub error cannot sink a release. ~keep
RUN for attempt in 1 2 3 4 5; do \
        XBERG_CACHE_DIR=/app/.xberg /usr/local/bin/xberg cache warm --cache-dir /app/.xberg --format json && break; \
        [ "$attempt" -lt 5 ] || exit 1; \
        echo "cache warm attempt $attempt failed; retrying" >&2; \
        sleep $((attempt * 20)); \
    done && \
    chown -R xberg:xberg /app/.xberg && \
    echo "All models ready (PaddleOCR + layout detection)"

RUN set -eux; \
    echo "Setting up tessdata permissions..."; \
    for dir in /usr/share/tesseract-ocr/*/tessdata /usr/share/tesseract-ocr/tessdata /usr/share/tessdata; do \
        if [ -d "$dir" ]; then \
            chmod -R a+rx "$dir" 2>/dev/null || true; \
            if [ -f "$dir/eng.traineddata" ]; then \
                echo "✓ Found tessdata with eng.traineddata at: $dir"; \
            fi; \
        fi; \
    done; \
    echo "✓ Tessdata permissions configured"

# Inspection only -- `docker inspect` on a shipped image shows which build id went into it. It has
# no runtime effect: `cache_version_tag` reads the value through `env!`, i.e. baked in at
# compile time, so setting this on a running container changes nothing. Mirrors the ARG/ENV
# pattern already used for PDFIUM_VERSION above. ~keep
ARG XBERG_BUILD_ID

# xberg-cli subscriber defaults in logging.rs, so they won't emit DEBUG
ENV XBERG_CACHE_DIR=/app/.xberg \
    HF_HOME=/app/.xberg/huggingface \
    RUST_LOG=info \
    LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/lib \
    PDFIUM_DYNAMIC_LIB_PATH=/usr/local/lib \
    XBERG_BUILD_ID=${XBERG_BUILD_ID}

USER xberg

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/xberg", "--version"]

ENTRYPOINT ["/usr/bin/tini", "--", "xberg"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]

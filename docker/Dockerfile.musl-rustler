# =============================================================================
# =============================================================================
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS builder

ARG CARGO_BUILD_JOBS=1

ARG RUST_TOOLCHAIN=1.99.1

WORKDIR /build

# Alpine's /bin/sh is busybox ash, which supports `-o pipefail`. Without it the
# `curl ... | sh` rustup bootstrap below reports only sh's status, so a failed or
# truncated download silently installs nothing, and the `readelf ... | grep`
# linkage diagnostic reports success on an empty pipe. (hadolint DL4006)
SHELL ["/bin/ash", "-o", "pipefail", "-c"]

RUN apk add --no-cache \
    curl musl-dev cmake make pkgconf bash patchelf \
    perl linux-headers git file && \
    apk add --no-cache \
        gcc g++ libstdc++ libstdc++-dev \
        onnxruntime-dev libheif-dev libde265-dev aom-dev x265-dev dav1d-dev \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain "${RUST_TOOLCHAIN}" --component rust-src && \
    echo "Rust host: $(~/.cargo/bin/rustc -vV | grep host)" && \
    echo "Default target: $(~/.cargo/bin/rustc --print cfg | grep target)"
ENV PATH="/root/.cargo/bin:${PATH}"

ENV ORT_LIB_LOCATION=/usr/lib
ENV ORT_PREFER_DYNAMIC_LINK=1
ENV ORT_SKIP_DOWNLOAD=1
ENV ORT_STRATEGY=system
ENV RUSTFLAGS="-C target-feature=-crt-static"

COPY Cargo.toml Cargo.lock ./
COPY vendored/sysinfo/ vendored/sysinfo/
COPY crates/xberg/ crates/xberg/
COPY crates/xberg-gliner/ crates/xberg-gliner/
COPY crates/xberg-tesseract/ crates/xberg-tesseract/
COPY crates/xberg-paddle-ocr/ crates/xberg-paddle-ocr/
COPY crates/xberg-candle-ocr/ crates/xberg-candle-ocr/
COPY crates/xberg-pdfium-render/ crates/xberg-pdfium-render/
COPY crates/xberg-native-pdf/ crates/xberg-native-pdf/
COPY crates/xberg-libheif/ crates/xberg-libheif/
COPY crates/xberg-libwpd/ crates/xberg-libwpd/
COPY packages/elixir/native/xberg_nif/ packages/elixir/native/xberg_nif/

RUN sed -i '/xberg-py/d; /xberg_rb/d; /xberg-node/d; /xberg-cli/d; /xberg-ffi/d; /xberg-jni/d; /xberg-php/d; /xberg-rag/d; /packages\/dart\/rust/d; /packages\/swift\/rust/d; /"crates\/xberg-wasm"/d; /^\[profile\.release\.package\.xberg-wasm\]$/,$d; /benchmark-harness/d; /e2e-generator/d; /e2e\/rust/d' Cargo.toml

# `.dockerignore` excludes `**/.git/`, so build.rs cannot derive XBERG_BUILD_ID from git here and
# falls back to `""` -- which makes every Elixir NIF built at the same crate version share one OCR
# cache key space (#1845). Declared immediately above the build step so a changed value does not
# invalidate the toolchain/dependency layers above. Unset is a hard failure and so is empty:
# build.rs honours the override only when it is non-empty, so an empty value falls straight back
# through its `!id.is_empty()` check and silently restores the collision. ~keep
ARG XBERG_BUILD_ID

RUN : "${XBERG_BUILD_ID:?must be passed: --build-arg XBERG_BUILD_ID=<commit sha>; see crates/xberg/build.rs}" && \
    cd packages/elixir/native/xberg_nif && \
    cargo build --release && \
    cp target/release/libxberg_nif.so /build/libxberg_nif.so && \
    strip /build/libxberg_nif.so

# Bundle the FULL transitive shared-lib closure (ONNX Runtime + image codecs,
# and everything THEY need in turn) beside libxberg_nif.so, and point every
# bundled library's RUNPATH at its own directory so the musl loader resolves
# them there. Unlike Dockerfile.musl-ffi/-node/-python, this build never
# vendored anything -- libxberg_nif.so shipped alone, so a BEAM VM without
# onnxruntime-dev (and its ~40 libabsl_*/libprotobuf-lite/libre2/libicu*
# dependents) installed system-wide fails to load it (xberg #1280).
# vendor-native-closure.sh walks `ldd` recursively instead of naming
# libraries by hand, and hard-fails the build (verify_local_closure) if
# anything is still unresolved after vendoring. ~keep
COPY scripts/ci/vendor-native-closure.sh /usr/local/bin/vendor-native-closure.sh
RUN bash /usr/local/bin/vendor-native-closure.sh /build/libxberg_nif.so

RUN file /build/libxberg_nif.so && \
    echo "=== Dynamic dependencies ===" && \
    readelf -d /build/libxberg_nif.so 2>/dev/null | grep NEEDED || echo "No dynamic dependencies (fully static)" && \
    echo "=== Bundled libraries ===" && \
    ls -la /build/*.so*

# `*.so*` (not `*.so`) is deliberate: Alpine's onnxruntime/libheif packages ship
# versioned sonames (libonnxruntime.so.1, libheif.so.1) that do not end in the
# literal ".so" suffix, so a plain `*.so` glob would silently drop them from
# this COPY -- leaving the NIF alone with no ORT (xberg #1280 recurrence).
FROM scratch
COPY --from=builder /build/*.so* /

# =============================================================================
# Fully static musl CLI for `cargo binstall xberg-cli`.
#
# Unlike Dockerfile.musl-build (which builds `--features all`, links ONNX/libheif
# dynamically, and ships a wrapper + bundled `lib/`), this builds the pure-Rust
# `binstall`/`binstall-ocr` profile with `+crt-static` so the result is ONE
# self-contained static ELF with no sibling dylibs — exactly what cargo-binstall
# extracts. The profile pulls no ONNX/Tesseract/libheif; the only C/C++ code is
# libwpd (WordPerfect) + a handful of `*-sys` crates (zstd, bzip2, ring), all
# compiled from source and statically linked, hence the static libstdc++/libgcc.
FROM alpine:3.24.3@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a AS builder

ARG CARGO_BUILD_JOBS=1

ARG RUST_TOOLCHAIN=1.99.1
# `binstall-ocr` (x86_64: extraction + Candle TrOCR/PaddleOCR-VL) or `binstall`
# (aarch64: extraction only — candle gemm-f16 needs fullfp16, absent on the musl
# aarch64 baseline). The publish workflow sets this per target.
ARG FEATURES=binstall-ocr
# Build triple; the publish workflow sets this per target. Passing an explicit
# `--target` is REQUIRED so cargo compiles proc-macros/build-scripts for the host
# WITHOUT the `+crt-static` flag (proc-macros must be dylibs) while still linking
# the target crates statically — see the per-target cargo config below.
ARG TARGET=x86_64-unknown-linux-musl

WORKDIR /build

# Alpine's /bin/sh is busybox ash, which supports `-o pipefail`. Without it the
# `curl ... | sh` rustup bootstrap below reports only sh's status, so a failed or
# truncated download silently installs nothing and the failure surfaces much later
# as a confusing "cargo: not found"; likewise a failed `readelf` in the static-
# linkage guards would be masked by the grep that consumes its empty output,
# turning those guards into checks that always pass. (hadolint DL4006)
SHELL ["/bin/ash", "-o", "pipefail", "-c"]

RUN apk add --no-cache \
    curl musl-dev cmake make pkgconf \
    perl linux-headers git file \
    gcc g++ libstdc++ libstdc++-dev

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain "${RUST_TOOLCHAIN}" --component rust-src && \
    echo "Rust host: $(~/.cargo/bin/rustc -vV | grep host)"
ENV PATH="/root/.cargo/bin:${PATH}"

# Ensure the target's std is present (no-op when it equals the toolchain host).
RUN rustup target add "${TARGET}"

# `+crt-static` statically links musl libc; `-static-libstdc++`/`-static-libgcc`
# fold libwpd's C++ runtime into the binary so nothing is left to resolve at load.
# These MUST live under `[target.<triple>]` (not the global RUSTFLAGS env): with an
# explicit `cargo build --target`, cargo applies target rustflags only to target
# crates and builds host proc-macros/build-scripts without them. A global env
# `RUSTFLAGS=+crt-static` instead breaks proc-macros ("cannot produce proc-macro
# ... target does not support these crate types"). Both triples are listed so this
# config is arch-agnostic; only the one matching `--target` takes effect.
RUN mkdir -p /build/.cargo && { \
      echo '[target.x86_64-unknown-linux-musl]'; \
      echo 'rustflags = ["-C", "target-feature=+crt-static", "-C", "link-arg=-static-libstdc++", "-C", "link-arg=-static-libgcc"]'; \
      echo ''; \
      echo '[target.aarch64-unknown-linux-musl]'; \
      echo 'rustflags = ["-C", "target-feature=+crt-static", "-C", "link-arg=-static-libstdc++", "-C", "link-arg=-static-libgcc"]'; \
    } > /build/.cargo/config.toml && cat /build/.cargo/config.toml

COPY Cargo.toml Cargo.lock ./
COPY vendored/sysinfo/ vendored/sysinfo/
COPY crates/xberg/ crates/xberg/
COPY crates/xberg-gliner/ crates/xberg-gliner/
COPY crates/xberg-cli/ crates/xberg-cli/
COPY crates/xberg-tesseract/ crates/xberg-tesseract/
COPY crates/xberg-paddle-ocr/ crates/xberg-paddle-ocr/
COPY crates/xberg-candle-ocr/ crates/xberg-candle-ocr/
COPY crates/xberg-pdfium-render/ crates/xberg-pdfium-render/
COPY crates/xberg-native-pdf/ crates/xberg-native-pdf/
COPY crates/xberg-libheif/ crates/xberg-libheif/
COPY crates/xberg-libwpd/ crates/xberg-libwpd/

RUN sed -i '/xberg-py/d; /xberg_rb/d; /xberg-node/d; /xberg-ffi/d; /xberg-jni/d; /xberg-php/d; /xberg-rag/d; /xberg_rustler/d; /xberg_nif/d; /packages\/dart\/rust/d; /packages\/swift\/rust/d; /"crates\/xberg-wasm"/d; /^\[profile\.release\.package\.xberg-wasm\]$/,$d; /benchmark-harness/d; /e2e-generator/d; /e2e\/rust/d' Cargo.toml

# `.dockerignore` excludes `**/.git/`, so build.rs cannot derive XBERG_BUILD_ID from git here and
# falls back to `""` -- which makes every binstall binary built at the same crate version share one OCR
# cache key space (#1845). Declared immediately above the build step so a changed value does not
# invalidate the toolchain/dependency layers above. Unset is a hard failure and so is empty:
# build.rs honours the override only when it is non-empty, so an empty value falls straight back
# through its `!id.is_empty()` check and silently restores the collision. ~keep
ARG XBERG_BUILD_ID

RUN : "${XBERG_BUILD_ID:?must be passed: --build-arg XBERG_BUILD_ID=<commit sha>; see crates/xberg/build.rs}" && \
    cargo build --release --package xberg-cli --target "${TARGET}" \
        --no-default-features --features "${FEATURES}" && \
    cp "target/${TARGET}/release/xberg" /build/xberg && \
    strip /build/xberg

# Fail the build unless the binary is genuinely static — no NEEDED entries, no
# interpreter — so a regression that reintroduces a dylib dep cannot ship.
RUN file /build/xberg && \
    if readelf -d /build/xberg 2>/dev/null | grep -q NEEDED; then \
        echo "FAIL: binary has dynamic NEEDED dependencies:" >&2; \
        readelf -d /build/xberg | grep NEEDED >&2; exit 1; \
    fi && \
    if readelf -l /build/xberg 2>/dev/null | grep -q INTERP; then \
        echo "FAIL: binary has a dynamic interpreter (not static):" >&2; exit 1; \
    fi && \
    /build/xberg --version && \
    echo "OK: fully static single-binary CLI (${FEATURES})"

FROM scratch
COPY --from=builder /build/xberg /xberg

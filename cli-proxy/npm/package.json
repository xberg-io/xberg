{
  "name": "@xberg-io/xberg-cli",
  "version": "1.5.3",
  "mcpName": "io.github.xberg-io/xberg",
  "description": "CLI proxy for xberg — runs the native xberg binary shipped in a per-platform package, downloading it from GitHub releases only as a fallback.",
  "license": "MIT",
  "author": {
    "name": "Na'aman Hirschfeld",
    "email": "naaman@xberg.io"
  },
  "contributors": [
    {
      "name": "Tobias Perlstein",
      "email": "tobias@xberg.io"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/xberg.git",
    "directory": "cli-proxy/npm"
  },
  "bin": {
    "xberg": "bin/xberg.js"
  },
  "files": [
    "bin/",
    "install.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}

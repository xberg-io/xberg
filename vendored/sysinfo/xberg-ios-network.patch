+#[test]
+#[cfg(target_os = "ios")]
+fn test_networks_remain_empty_on_ios() {
+    let mut networks = Networks::new();
+    assert!(networks.list().is_empty());
+    networks.refresh(false);
+    assert!(networks.list().is_empty());
+    networks.refresh(true);
+    assert!(networks.list().is_empty());
+    assert!(Networks::new_with_refreshed_list().list().is_empty());

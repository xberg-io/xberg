+                effective: &no_dpi,
+                ..fixture.call(2)
+            },
+        )
+        .await
+        .unwrap();
+        run(
+            &reuse,
+            Call {
+                backend: &paddle_backend,
+                ..fixture.call(3)
+            },
+        )
+        .await
+        .unwrap();
+        for (index, effective) in [&rotating, &nested_rotation].into_iter().enumerate() {
+            run(
+                &reuse,
+                Call {
+                    effective,
+                    ..fixture.call(4 + index as u32)
+                },
+            )
+            .await
+            .unwrap();
+        }
+        reuse.finish(&[1, 2, 3, 4, 5]);
+    }
+    assert_eq!(
+        fixture.fake.calls(),

+            .repeat(4)
+            .split_whitespace()
+            .collect::<Vec<_>>()
+    );
+    let inputs = registered.0.inputs.lock().unwrap();
+    assert_eq!(inputs.len(), 2);
+    assert_eq!(inputs[0].1, inputs[1].1);

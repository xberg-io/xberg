{
  "name": "@xberg-io/xberg",
  "version": "1.1.6",
  "description": "High-performance document intelligence library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xberg-io/xberg.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "files": ["index.js", "index.d.ts", "*.node"],
  "napi": {
    "packageName": "@xberg-io/xberg",
    "binaryName": "xberg-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "npx --yes -p @napi-rs/cli@^3.7.3 napi build --platform --release",
    "artifacts": "npx --yes -p @napi-rs/cli@^3.7.3 napi artifacts",
    "prepublishOnly": "npx --yes -p @napi-rs/cli@^3.7.3 napi prepublish -t npm --skip-optional-publish"
  },
  "engines": { "node": ">= 22" },
  "publishConfig": { "access": "public" },
  "devDependencies": { "@napi-rs/cli": "^3.7.3", "@types/node": "^26.0.0" }
}
